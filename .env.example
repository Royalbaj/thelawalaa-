# Public (safe to expose — anon key is protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_SITE_URL=https://thelawalaa.com

# Server-only (NO NEXT_PUBLIC_ prefix — never reaches the browser)
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
OTP_HMAC_SECRET=   # long random string, e.g. `openssl rand -hex 32`

# ── eSewa online payment (optional — sandbox works with no keys set) ──
# Leave unset to use eSewa's public test merchant (EPAYTEST). Get real
# values from your eSewa merchant dashboard before going live.
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
ESEWA_MODE=   # "live" to use production eSewa; anything else (or unset) = sandbox

# ── SEO (optional but recommended) ──
# From Google Search Console → Settings → Ownership verification → HTML tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# From Bing Webmaster Tools
NEXT_PUBLIC_BING_SITE_VERIFICATION=
